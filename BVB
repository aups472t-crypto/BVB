local bannerLabel = Instance.new("TextLabel")
bannerLabel.Name = "AnnouncementBanner"
bannerLabel.Size = UDim2.new(0.8, 0, 0.14, 0)
bannerLabel.Position = UDim2.new(0.1, 0, 0.16, 0)
bannerLabel.BackgroundTransparency = 1
bannerLabel.Text = ""
bannerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
bannerLabel.TextStrokeTransparency = 0.15
bannerLabel.TextStrokeColor3 = Color3.fromRGB(20, 20, 25)
bannerLabel.Font = Enum.Font.GothamBlack
bannerLabel.TextScaled = true
bannerLabel.Visible = false
bannerLabel.Parent = screenGui

local function showBanner(text: string, color: Color3?)
	bannerLabel.Text = text
	bannerLabel.TextColor3 = color or Color3.fromRGB(255, 255, 255)
	bannerLabel.Position = UDim2.new(0.1, 0, 0.12, 0)
	bannerLabel.TextTransparency = 1
	bannerLabel.TextStrokeTransparency = 1
	bannerLabel.Visible = true

	local fadeIn = TweenService:Create(bannerLabel, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.1, 0, 0.18, 0),
		TextTransparency = 0,
		TextStrokeTransparency = 0.15,
	})
	fadeIn:Play()

	task.delay(3.2, function()
		if bannerLabel.Text == text then
			local fadeOut = TweenService:Create(bannerLabel, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.new(0.1, 0, 0.13, 0),
				TextTransparency = 1,
				TextStrokeTransparency = 1,
			})
			fadeOut:Play()
			fadeOut.Completed:Once(function()
				if bannerLabel.Text == text then
					bannerLabel.Visible = false
				end
			end)
		end
	end)
end

-- เอฟเฟกต์ฝนดาวตกฝั่ง Client
local function spawnMeteorVisual(targetPos: Vector3)
	local startPos = targetPos + Vector3.new(math.random(-25, 25), 140, math.random(-25, 25))
	local meteor = Instance.new("Part")
	meteor.Shape = Enum.PartType.Ball
	meteor.Size = Vector3.new(6, 6, 6)
	meteor.Material = Enum.Material.Neon
	meteor.Color = Color3.fromRGB(255, 110, 25)
	meteor.Anchored = true
	meteor.CanCollide = false
	meteor.CFrame = CFrame.new(startPos)
	meteor.Parent = workspace

	local tween = TweenService:Create(meteor, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = targetPos,
		Size = Vector3.new(10, 10, 10),
	})
	tween:Play()
	Debris:AddItem(meteor, 0.6)
end

-- เอฟเฟกต์ลำแสงอาทิตย์และคัตซีนกล้อง
local function playCutscene(mode: string, targetPos: Vector3)
	if isPlayingCutscene then
		return
	end
	isPlayingCutscene = true

	local camera = workspace.CurrentCamera
	local originalType = camera.CameraType
	local originalCFrame = camera.CFrame
	camera.CameraType = Enum.CameraType.Scriptable

	if mode == "Supernova" then
		local star = Instance.new("Part")
		star.Shape = Enum.PartType.Ball
		star.Size = Vector3.new(4, 4, 4)
		star.Material = Enum.Material.Neon
		star.Color = Color3.fromRGB(255, 240, 150)
		star.Anchored = true
		star.CanCollide = false
		star.Position = targetPos + Vector3.new(0, 35, 0)
		star.Parent = workspace

		local camGoal = CFrame.lookAt(targetPos + Vector3.new(28, 22, 28), targetPos + Vector3.new(0, 10, 0))
		TweenService:Create(camera, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = camGoal }):Play()
		TweenService:Create(star, TweenInfo.new(1.05, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
			Size = Vector3.new(55, 55, 55),
			Position = targetPos,
		}):Play()

		task.wait(1.25)
		Debris:AddItem(star, 0.5)

	elseif mode == "SolarBeam" then
		local beam = Instance.new("Part")
		beam.Material = Enum.Material.Neon
		beam.Color = Color3.fromRGB(255, 220, 70)
		beam.Anchored = true
		beam.CanCollide = false
		beam.Size = Vector3.new(8, 260, 8)
		beam.Position = targetPos + Vector3.new(0, 130, 0)
		beam.Parent = workspace

		local camGoal = CFrame.lookAt(targetPos + Vector3.new(35, 26, 35), targetPos)
		TweenService:Create(camera, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = camGoal }):Play()
		TweenService:Create(beam, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(24, 260, 24),
		}):Play()

		task.wait(1.05)
		Debris:AddItem(beam, 0.6)
	end

	camera.CameraType = originalType
	camera.CFrame = originalCFrame
	isPlayingCutscene = false
end

broadcastEvent.OnClientEvent:Connect(function(kind: string, arg1: any, arg2: any)
	if kind == "Banner" then
		showBanner(tostring(arg1), arg2)
	elseif kind == "MeteorVisual" and typeof(arg1) == "Vector3" then
		spawnMeteorVisual(arg1)
	elseif kind == "Cutscene" and typeof(arg2) == "Vector3" then
		playCutscene(tostring(arg1), arg2)
	end
end)

-- สร้างเครื่องมือสำหรับผู้เล่น (Tool)
local function giveTargetedTool(toolName: string, handleColor: Color3, actionName: string)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	local existing = backpack:FindFirstChild(toolName) or (player.Character and player.Character:FindFirstChild(toolName))
	if existing then
		existing:Destroy()
	end

	local tool = Instance.new("Tool")
	tool.Name = toolName
	tool.RequiresHandle = true

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 4)
	handle.Color = handleColor
	handle.Material = Enum.Material.Neon
	handle.Parent = tool

	local cooldown = false
	tool.Activated:Connect(function()
		if cooldown then
			return
		end
		cooldown = true
		local hitPos = mouse.Hit.Position
		adminAction:FireServer(actionName, hitPos)
		task.wait(1.5)
		cooldown = false
	end)

	tool.Parent = backpack
end

